<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.maestro</groupId>
    <artifactId>maestro-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>maestro-api</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.maestro</groupId>
      <artifactId>maestro-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.maestro</groupId>
      <artifactId>maestro-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.maestro</groupId>
      <artifactId>maestro-persistence-sqlite</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot.version}</version>
        <configuration>
          <skip>false</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
